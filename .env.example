# ==============================================================================
# SevaSaarthi Environment Configuration (.env)
# ==============================================================================

# Supabase Configuration (Frontend - Safe public keys)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side LLM Configuration (NEVER exposed to frontend bundle)
# Accessible only via Vite server middleware / server-side function
GEMINI_API_KEY=your-google-gemini-api-key
LLM_MODEL=gemini-1.5-flash

# Note: If credentials are not provided, SevaSaarthi automatically uses its
# built-in local JSON and keyword/rule retrieval fallback without errors.
